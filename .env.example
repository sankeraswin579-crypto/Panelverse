# Copy this file to .env for local development.
# Never commit the real .env file or share its values.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
SESSION_SECRET=replace_with_a_random_secret_at_least_32_characters_long
NODE_ENV=development
PORT=3000
# Optional: TMDB v3 API key or v4 read access token for movie/TV artwork.
# Set the valid credential in the deployment environment (for example, Render).
# TMDB_API_KEY=
# TMDB_READ_ACCESS_TOKEN=
